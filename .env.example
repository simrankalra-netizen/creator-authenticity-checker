# Copy this file to .env.local and put your real values there. Never commit .env.local.
GEMINI_API_KEY=

# Where creators come from. demo = made-up demo creators; apify = real public Instagram data.
DATA_SOURCE=demo
# Apify API token (console.apify.com → Settings → API & Integrations). Server only.
APIFY_TOKEN=
# on = also read 10 comments on 2 posts of the best 30 creators (about $1.56 more per search)
APIFY_COMMENTS=off

# Verification codes. demo = no SMS is sent and the code is always 123456.
# Switch to twilio and fill the TWILIO_* values to send real SMS.
SMS_MODE=demo
# Any long random string; signs the demo-code cookie. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_COOKIE_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
